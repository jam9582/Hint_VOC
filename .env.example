# 이 파일을 복사해 .env.local을 만들고 값을 채운다. (cp .env.example .env.local)

# 공개용 값. 브라우저에 노출되도록 만들어진 값이고, 권한 정책(RLS)이 데이터를 지킨다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키(sb_secret_...). 서버 코드에서만 쓴다.
# 절대 NEXT_PUBLIC_ 을 붙이지 않는다. 붙이면 브라우저 코드에 들어간다.
SUPABASE_SECRET_KEY=

# 지연 알림 메일 (선택). 비워 두면 메일을 보내지 않는다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 지연 알림 실행 주소를 부를 때 쓰는 비밀 값. 길고 임의의 글자로 정한다.
CRON_SECRET=
